\par }\pard\plain \s15\sa160\sl-240\slmult0\widctlpar\adjustright \fs21\cgrid {The following excerpt of sample code shows how a driver can send an IOCTL to the ACPI driver. Notice the use of the }{\b KeInitializeEvent}{ and }{\b KeWaitForSingleObject}{
 function calls to wait for the IRP to complete. (For information about these two functions, see the NT DDK documentation on the MSDN Professional Level CDs.) 
\par }\pard\plain \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright \f2\fs16\cgrid {NTSTATUS
\par SendDownStreamIrp(
\par     IN PDEVICE_OBJECT   Pdo,
\par     IN ULONG            Ioctl,
\par     IN PVOID            InputBuffer,
\par     IN ULONG            InputSize,
\par     IN PVOID            OutputBuffer,
\par     IN ULONG            OutputSize
\par )
\par /*
\par Routine Description:
\par     General-purpose function called to send a request to the Pdo. 
\par     The Ioctl argument accepts the control method being passed down
\par     by the calling function.This subroutine is only valid for the IOCTLS other than ASYNC EVAL. }{\b\i It is not certain whether ACQUIRE_LOCK or REMOVE_LOCK is used here.
\par }{Arguments:
\par     Pdo             - the request is sent to this device object
\par     Ioctl           - the request - specified by the calling function
\par     InputBuffer     - incoming request
\par     InputSize       - size of the incoming request
\par     OutputBuffer    - the answer
\par     OutputSize      - size of the answer buffer
\par Return Value:
\par     NT Status of the operation
\par */
\par \{
\par     IO_STATUS_BLOCK     ioBlock;
\par     KEVENT              MyIoctlEvent;
\par     NTSTATUS            Status;
\par     PIRP                Irp;
\par 
\par     // Initialize an event to wait on
\par     KeInitializeEvent(&MyIoctlEvent, SynchronizationEvent, FALSE);
\par 
\par     // Build the request
\par     Irp = IoBuildDeviceIoControlRequest(
\par         Ioctl, 
\par         Pdo,
\par         InputBuffer,
\par         InputSize,
\par         OutputBuffer,
\par         OutputSize,
\par         FALSE,
\par         &MyIoctlEvent,
\par         &ioBlock);
\par 
\par     if (!Irp) \{
\par         return STATUS_INSUFFICIENT_RESOURCES;
\par     \}
\par 
\par     // Pass request to Pdo, always wait for completion routine
\par     Status = IoCallDriver(Pdo, Irp);
\par 
\par     if (Status == STATUS_PENDING) \{
\par         // Wait for the IRP to be completed, then grab the real status code
\par         KeWaitForSingleObject(
\par             &MyIoctlEvent,
\par             Executive,
\par             KernelMode,
\par             FALSE,
\par             NULL);
\par 
\par         Status = ioBlock.Status;
\par     \}
\par 
\par     // Sanity check the data
\par     if (OutputBuffer != NULL) \{
\par         if ( ( (PACPI_EVAL_OUTPUT_BUFFER) OutputBuffer->Signature != 
\par             ACPI_EVAL_OUTPUT_BUFFER_SIGNATURE ||
\par             ( (PACPI_EVAL_OUTPUT_BUFFER) OutputBuffer->Count == 0) \{
\par             Status = STATUS_ACPI_INVALID_DATA;
\par         \}
\par     // Done
\par     return Status;
\par \}
\par }\pard\plain \s23\qr\sl-160\slmult0\widctlpar\adjustright \fs12\cgrid {
\par }\pard\plain \s15\sa160\sl-240\slmult0\widctlpar\adjustright \fs21\cgrid {The following excerpt of driver code shows }{\b IOCTL_ACPI_EVAL_METHOD}{ being called out. This sample code gets a device status via the _STA method and calls the }{\b 
SendDownStreamIrp}{ function shown earlier in this section. For a discussion of the ACPI driver data structures used in the code below, see \ldblquote ACPI Driver Interface Structure Interface\rdblquote 
 in the Reference section of this document. The ACPI data structures and constants called out here are defined in Acpiioct.h, which is located in the Windows 98 DDK.
\par }\pard\plain \s53\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright \f2\fs16\cgrid {NTSTATUS
\par GetStaData(
\par     IN PDEVICE_OBJECT   Pdo,
\par     OUT PULONG          ReturnStatus
\par     )
\par /*++
\par 
\par Routine Description:
\par     Called to get a device status via the _STA method.   Generic, works for
\par     any device with the _STA method (assuming caller has a Pdo).
\par 
\par Arguments:
\par     Pdo             - For the device.
\par     ReturnStatus    - Pointer to where the status data is placed.
\par 
\par Return Value:
\par     NT Status of the operation
\par 
\par --*/
\par \{
\par     ACPI_EVAL_INPUT_BUFFER  inputBuffer;
\par     ACPI_EVAL_OUTPUT_BUFFER outputBuffer;
\par     NTSTATUS                status;
\par     PACPI_METHOD_ARGUMENT   argument;
\par 
\par     .
\par     .
\par     .
\par 
\par     ASSERT( ReturnStatus != NULL );
\par     *ReturnStatus = 0x0;
\par 
\par     // Fill in the input data
\par     inputBuffer.MethodNameAsUlong = MYDRIVER_STA_METHOD;
\par     inputBuffer.Signature = ACPI_EVAL_INPUT_BUFFER_SIGNATURE;
\par 
\par     // Send the request along
\par     status = SendDownStreamIrp(
\par        Pdo,
\par        IOCTL_ACPI_EVAL_METHOD,
\par        &inputBuffer,
\par        sizeof(ACPI_EVAL_INPUT_BUFFER),
\par        &outputBuffer,
\par        sizeof(ACPI_EVAL_OUTPUT_BUFFER)
\par        );
\par     if (!NT_SUCCESS(status)) \{
\par        return status;
\par     \}
\par 
\par     // Grab the argument
\par     argument = outputBuffer.Argument;
\par     status = GetDwordElement( argument, ReturnStatus );}{\b\i Get Dword Element ( ) code needed here.
\par }{    return status;
\par \}
\par }\pard\plain \s23\qr\sl-160\slmult0\widctlpar\adjustright \fs12\cgrid {
