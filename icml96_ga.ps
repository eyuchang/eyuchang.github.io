/ldf {dup matrix scale exch matrix rotate
      matrix concatmatrix
      exch police exch get findfont
      exch makefont setfont
      } def
 
/g {setgray} def
/c {setrgbcolor} def
/cl {closepath} def
/s {stroke} def
/m {moveto} def
/l {lineto} def
/matrice1 {matini setmatrix ccx cm ccy cm translate
           angle rotate
           echelle cm dup scale
           hx 2 div neg
           hy 2 div neg translate} def
/matrice {matini setmatrix  
          ccx decxcm add cm
          ccy decycm add cm translate
          angle rotate
          echelle cm dup scale
          zoomx zoomy scale
          hx 2 div neg
          hy 2 div neg translate} def
/cadre {
    currentlinewidth 2 div neg dup
    hx exch sub
    currentlinewidth 2 div neg dup
    hy exch sub rec} def
/showcadre {gsave initclip matrice1 kadre
             {.05 setlinewidth [] 0 setdash
            0. setgray cadre stroke}
              if
            grestore} def
/sg {moveto lineto stroke} def
/sge {moveto lineto gsave 1. setgray
      [] 0 setdash stroke grestore stroke} def
/d {currentgray mark} def
/f {setgray newpath moveto
      counttomark 2 idiv {lineto} repeat
    closepath fill cleartomark setgray} def
/inc {matrice1 initclip 0 hx 0 hy rec
      clip newpath matrice} def
/hdc {inc rec clip newpath} def
/aller {3 copy 3 1 roll moveto currentlinewidth
        exch dup .1 mul setlinewidth} def
/seg0 {aller dup neg 0 exch 0 rmoveto rlineto
       stroke setlinewidth} def
/seg1 {aller .70711 mul dup dup neg dup rmoveto
       rlineto stroke setlinewidth} def
/seg2 {aller dup neg 0 exch 0 4 1 roll rmoveto
       rlineto stroke setlinewidth} def
/seg3 {aller .70711 mul neg dup neg dup dup neg
       rmoveto rlineto stroke setlinewidth} def
/cplus {seg0 neg seg0 seg2 neg seg2
       pop pop pop} def
/cx {seg1 neg seg1 seg3 neg seg3
       pop pop pop} def
/cstar {3 copy cplus cx} def
/rond  {currentlinewidth 4 1 roll dup .1 mul
       setlinewidth 0 360 arc stroke
       setlinewidth} def
/rond2 {0 360 arc stroke} def
/rondf {0 360 arc fill} def
/ecr {dup 5 1 roll stringwidth
      2 index neg mul 3 index add exch
      2 index neg mul 4 index add exch
      moveto pop pop pop show newpath} def
/cartouche{/dessin dessin 1 add def
           latex not
          {gsave initgraphics
           1 cm 1 cm scale
        grestore}
        if} def
/typetrait [[]
            [0.03 .07]
            [0.1]
            [0.05 0.07 .2 0.07]
            [0.15 0.07]
            [0.03 0.03 .03 .08]
            [0.03 0.05 .03 .05 .15 .05]
            [0.25 .07]] def
/dt {dup 0 lt
     {pop}
     {8 mod typetrait exch get 0 setdash}
     ifelse
     dup 0 lt {pop}
     {.1 mul setlinewidth}
     ifelse} def
/initf3d {gsave /initCPU usertime def
    /dessin 1 def /matini matrix currentmatrix def
    latex
    {/echelle
      hhx hx angle cos mul abs
          hy angle sin mul abs add div
      hhy hx angle sin mul abs
          hy angle cos mul abs add div
      2 copy
      gt {exch} if pop
      def
      /xmin 0. def
      /xmax hx def
      /ymin 0. def
      /ymax hy def
      %-- position du cadre dans le rectangle
      currentpoint
      /ccy exch ptcm div def
      /ccx exch ptcm div def
    }
    {/echelle 1 def
     /xmin 0. def
     /xmax hx def
     /ymin 0. def
     /ymax hy def
     /ccx xpapier 2 div def
     /ccy ypapier 2 div def
    }
    ifelse
    /dessin 0 def
    matrice
    showcadre
    cartouche
    inc
    } def
 
