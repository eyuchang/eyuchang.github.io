body {
	font-family: roboto;
	margin: 70px;
}

.side {
	position:fixed;
	transform: rotate(90deg);
	color:black;
	transition: 0.5s;
}

#bio {
	right:20px;
	top:20px;
}

#pub {
	right:-20px;
	top: 130px;
}

#research {
	right:-5px;
	top:270px;
}

#teach {
	right:-5px;
	top:390px;
}

@media only screen and (min-width:810px){

	.pubimg {
		float:left;
		display: flex;
		margin-right: 40px;
		width:200px;
		height:140px;
	}
	
}


@media only screen and (max-width:810px){

	.pubimg {
		float:left;
		display: flex;
		margin-right: 40px;
		width:200px;
		height:180px;
	}
	
}

