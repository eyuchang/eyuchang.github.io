\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrstop36\adjustright {
Immediately before doing something that needs to be synchronized, initiate an IRP with the IOCTL code }{\b IOCTL_ACPI_ACQUIRE_GLOBAL_LOCK}{.
\par {\pntext\pard\plain\s15 \fs21\cgrid \hich\af0\dbch\af0\loch\f0 2.\tab}}\pard \s15\fi-360\li360\sl-240\slmult0\widctlpar{\*\pn \pnlvlbody\ilvl0\ls21\pnrnot0\pndec\pnstart1\pnindent360\pnhang{\pntxta .}}\ls21
\ls21\pnrauth1\pnrdate639921100\pnrstart0\pnrxst2\pnrxst0\pnrxst0\pnrxst0\pnrxst46\pnrxst0\pnrstop6\pnrstart1\pnrrgb1\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrstop9\pnrstart2\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0
\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc2\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrstop18\pnrstart3\pnrpnbr2\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0
\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrstop36\adjustright {
When that IRP completes, the initiating driver owns the Global Lock.
\par {\pntext\pard\plain\s15 \fs21\cgrid \hich\af0\dbch\af0\loch\f0 3.\tab}}\pard \s15\fi-360\li360\sl-240\slmult0\widctlpar{\*\pn \pnlvlbody\ilvl0\ls21\pnrnot0\pndec\pnstart1\pnindent360\pnhang{\pntxta .}}\ls21
\ls21\pnrauth1\pnrdate639921100\pnrstart0\pnrxst2\pnrxst0\pnrxst0\pnrxst0\pnrxst46\pnrxst0\pnrstop6\pnrstart1\pnrrgb1\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrrgb0\pnrstop9\pnrstart2\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0
\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc3\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrnfc0\pnrstop18\pnrstart3\pnrpnbr3\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0
\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrpnbr0\pnrstop36\adjustright {As s
oon as possible, release the Global Lock by initiating an IRP with the IOCTL code }{\b IOCTL_ACPI_RELEASE_GLOBAL_LOCK}{.
\par }\pard\plain \s23\qr\sl-160\slmult0\widctlpar\adjustright \fs12\cgrid {
\par }\pard\plain \s15\sa160\sl-240\slmult0\widctlpar\adjustright \fs21\cgrid {\b IOCTL_ACPI_ACQUIRE_GLOBAL_LOCK}{ enables a device driver to synchronize with the ACPI driver and system firmware by acquiring the ACPI Global L
ock.  The caller passes a buffer to receive an }{\b ACPI_GLOBAL_LOCK}{ structure. This structure holds private data that the ACPI driver uses to track requests for the global lock. 
\par }{\b IOCTL_ACPI_RELEASE_GLOBAL_LOCK}{ releases the ACPI Global Lock after a driver acquires it with }{\b IOCTL_ACPI_ACQUIRE_GLOBAL_LOCK}{. The }{\b ACPI_GLOBAL_LOCK}{ structure passed to this IOCTL must be the same structure returned earlier from }{\b 
IOCTL_ACPI_ACQUIRE_GLOBAL_LOCK}{.
\par An example of code that acquires the global lock is shown below}{\b\i .
\par }\pard\plain \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright \f2\fs16\cgrid {typedef struct \{
\par \tab PDEVICE_OBJECT\tab \tab DeviceObject;
\par \tab PDEVICE_OBJECT\tab \tab NextFdo;
\par \tab PDEVICE_OBJECT\tab \tab Pdo;\tab \tab \tab \tab \tab // Pdo corresponding to this fdo
\par \tab PDEVICE_OBJECT\tab \tab LowerDeviceObject;
\par }\pard \s53\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright {\tab \tab // Static device information
\par \tab \tab PUCHAR\tab \tab \tab \tab DataPort;\tab \tab \tab \tab // MyDevice Data port
\par \tab \tab PUCHAR\tab \tab \tab \tab StatusPort;\tab \tab \tab \tab // MyDevice Status port
\par \tab \tab PUCHAR\tab \tab \tab \tab CommandPort;\tab \tab \tab // MyDevice Command port
\par }\pard \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright {\tab \tab .
\par \tab \tab .
\par \tab \tab .
\par \tab // Global Lock
\par \tab ACPI_GLOBAL_LOCK    GlobalLock;
\par \tab UCHAR               GlobalLockState;
\par \tab PIRP                GlobalLockRequest;  // IRP to acquire/release global lock
\par \tab \tab .
\par \tab \tab .
\par \tab \tab .
\par }\pard \s53\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright {\tab MYDEVDATA, *PMYDEVDATA;
\par \tab 
\par \tab VOID
\par }\pard \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright {AcpiMyDriverAcquireGlobalLock (
\par     IN PMYDEVDATA              MyDevData
\par     )
\par /*
\par Routine Description:
\par     Call ACPI driver to obtain the global lock
\par Arguments:
\par     MyDevData  - Pointer to my device to service.
\par Return Value:
\par     None.
\par */
\par \{
\par     PIRP                Irp;
\par     PIO_STACK_LOCATION  IrpSp;
\par \tab // Call ACPI to obtain the lock
\par \tab Irp = MyDevData->GlobalLockRequest;
\par \tab IoInitializeIrp(Irp, MyDevData->IrpSize, MyDevData->LowerDeviceObject->StackSize);
\par \tab IrpSp = IoGetNextIrpStackLocation(Irp);
\par \tab IrpSp->MajorFunction = IRP_MJ_DEVICE_CONTROL;
\par \tab IrpSp->Parameters.DeviceIoControl.IoControlCode = IOCTL_ACPI_ACQUIRE_GLOBAL_LOCK;
\par \tab IrpSp->Parameters.DeviceIoControl.InputBufferLength = sizeof(ACPI_GLOBAL_LOCK);
\par \tab Irp->AssociatedIrp.SystemBuffer = &MyDevData->GlobalLock;
\par     IoSetCompletionRoutine(Irp,AcpiMyDevGlobalLockAcquired,MyDevData,TRUE,TRUE,TRUE);
\par \tab // Send to ACPI driver
\par \tab IoCallDriver (MyDevData->LowerDeviceObject, Irp);
\par \}
\par 
\par }\pard\plain \widctlpar\adjustright \fs20\cgrid {The following sample code releases the Global Lock. The }{\b KeAcquireSpinLock}{ and }{\b KeReleaseSpinLock}{
 function calls are used when there can be multiple devices of this type in the system and/or when a driver has multiple threads. For more information about the }{\b KeAcquireSpinLock}{ and }{\b KeReleaseSpinLock}{ function
s, see the NT DDK documentation on the MSDN Professional Level CD-ROM. 
\par }\pard\plain \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright \f2\fs16\cgrid {
\par VOID
\par AcpiMyDevReleaseGlobalLock (
\par     IN PMYDEVDATA              MyDevData
\par     )
\par /*
\par Routine Description:
\par     Call ACPI driver to release the global lock
\par Arguments:
\par     MyDevData  - Pointer to embedded controller to service.
\par Return Value:
\par     None.
\par */
\par \{
\par     KIRQL               OldIrql;
\par     PIRP                Irp;
\par     PIO_STACK_LOCATION  IrpSp;
\par     KEVENT              pdoStartedEvent;
\par \tab 
\par \tab KeAcquireSpinLock(&MyDevData->Lock, &OldIrql);
\par \tab if (MyDevData->InServiceLoop) \{
\par \tab \tab // InServiceLoop is set, so GlobalLock is going to be needed
\par \tab \tab // immediately.  Don't bother with the release of it
\par \tab \tab KeReleaseSpinLock (&MyDevData->Lock, OldIrql);
\par \tab \tab return;
\par     \}
\par \tab // Mark releasing
\par \tab MyDevData->GlobalLockState = MYDEV_GL_RELEASING;
\par \tab KeReleaseSpinLock (&MyDevData->Lock, OldIrql);
\par \tab // Call ACPI to release the Global Lock
\par \tab KeInitializeEvent (&pdoStartedEvent, SynchronizationEvent, FALSE);
\par \tab Irp = MyDevData->GlobalLockRequest;
\par \tab IoInitializeIrp(Irp, MyDevData->IrpSize,MyDevData->LowerDeviceObject->StackSize);
\par \tab IrpSp = IoGetNextIrpStackLocation(Irp);
\par \tab IrpSp->MajorFunction = IRP_MJ_DEVICE_CONTROL;
\par \tab IrpSp->Parameters.DeviceIoControl.IoControlCode = IOCTL_ACPI_RELEASE_GLOBAL_LOCK;
\par \tab IrpSp->Parameters.DeviceIoControl.InputBufferLength = sizeof(ACPI_GLOBAL_LOCK);
\par \tab Irp->AssociatedIrp.SystemBuffer = &MyDevData->GlobalLock;
\par \tab IoSetCompletionRoutine(Irp,AcpiMyDevIoCompletion,&pdoStartedEvent,TRUE,TRUE,TRUE);
\par \tab // Send to ACPI driver
\par \tab IoCallDriver (MyDevData->LowerDeviceObject, Irp);
\par \tab // Mark released
\par \tab KeAcquireSpinLock (&MyDevData->Lock, &OldIrql);
\par \tab MyDevData->GlobalLockState = MYDEV_GL_NOT_OWNED;
\par \tab KeReleaseSpinLock (&MyDevData->Lock, OldIrql);
\par \}
\par }\pard\plain \s23\qr\sl-160\slmult0\widctlpar\adjustright \fs12\cgrid {
