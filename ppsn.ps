%%BeginDocument: dess.100.2.0.eps
%
300 dict begin
%  debut des variables postscript modifiables
%  ------------------------------------------
% - decxcm et decycm permettent de
%   decaler le dessin resp. vers la droite
%   et vers le haut (la feuille est verticale)
 
/decxcm 0. def
/decycm 0. def
 
% - angle permet de tourner le dessin
%   en degres
 
 /angle  .0 def
 
% - zoomx zoomy permet de grossir le dessin
%   facteur d'agrandissement resp.
%   dans la direction x et y
%   du dessin initial
 
/zoomx 1. def
/zoomy 1. def
 
% tex permet d'inserer un dessin postscript
%
%  si latex est vrai => showdessin est faux 
%  Pour utilisation avec dvi2ps faire :
%             latex faux et showdessin vrai
% -----------------------------------------
/latex dup where {pop true}{false} ifelse  def
/showdessin latex not def
 
% kadre permet d'encadrer le dessin
 
/kadre false def
%
%  fin des variables postscript modifiables
%  ----------------------------------------
 /hx  19.0 def
 /hy  13.03249 def
 /xpapier  21.0 def 
 /ypapier  29.7 def
% %%%%%%%%%%%%%% debut des definition %%%%%%%%%%
% %%%%%%%%%%%%%%    des macros        %%%%%%%%%%
% %%%%%%%%  PostScript pour Fortran 3D %%%%%%%%%%
%       definition des commandes
%   syntaxe      ;     action
% x2 y2 x1 y2 sg ;
%        trace le segment (x1,y1) (x2,y2)
% x2 y2 x1 y2 sge ;
%         efface et trace le segment (x1,y1) (x2,y2)
% d x1 y1 .... xn yn gris f ;
%        remplie le contour de la couleur gris
%
% jeux sens taille  ldf
%      load la font : jeux,sens,taille
%      sens en degres
%       0<jeux<36
% epais type dt ;
%        definit type trait et l'epaisseur en mm
% inc :   met le clipping sur le rectangle 0 hx 0 hy
% xmin xmax ymin ymax hdc : met
%     le clipping sur le rectangle xmin xmax ymin ymax
% initf3d : initialise f3d
% finf3d  : termine f3d
/ptcm 28.3464566929134 def
/cm {ptcm mul} def
% ---   construction de la matrice de changement
% ---   de base l'origine est (xmin,ymin)
%           dans le rectangle
% ------------------------------------------
% --- on est au centre du dessin -----------
 
/rec {newpath 4 copy 8 1 roll moveto
       3 -1 roll lineto 4 2 roll exch
        lineto lineto closepath} def
/police [
   (Courier)
   (NewCenturySchlbk-Italic)
   (Bookman-LightItalic)
   (Helvetica)
   (Courier-Bold)
   (Helvetica-Narrow-Bold)
   (Courier-BoldOblique)
   (Times-Italic)
   (Times-Bold)
   (NewCenturySchlbk-Roman)
   (Helvetica-Narrow-Oblique)
   (Bookman-DemiItalic)
   (Symbol)
   (Bookman-Demi)
   (Helvetica-BoldOblique)
   (Bookman-Light)
   (Helvetica-Oblique)
   (AvantGarde-Book)
   (AvantGarde-DemiOblique)
   (AvantGarde-BookOblique)
   (AvantGarde-Demi)
   (Helvetica-Narrow)
   (ZapfChancery-MediumItalic)
   (Courier-Oblique)
   (NewCenturySchlbk-BoldItalic)
   (Helvetica-Bold)
   (Times-Roman)
   (Times-BoldItalic)
   (Helvetica-Narrow-BoldOblique)
   (NewCenturySchlbk-Bold)
   (Palatino-Bold)
   (Courier)
   (Palatino-Italic)
   (Palatino-Roman)
   (Palatino-BoldItalic)
   (ZapfDingbats)
    ] def
/ldf {dup matrix scale exch matrix rotate
      matrix concatmatrix
      exch police exch get findfont
      exch makefont setfont
      } def
 
/g {setgray} def
/c {setrgbcolor} def
/cl {closepath} def
/s {stroke} def
/m {moveto} def
/l {lineto} def
/matrice1 {matini setmatrix ccx cm ccy cm translate
           angle rotate
           echelle cm dup scale
           hx 2 div neg
           hy 2 div neg translate} def
/matrice {matini setmatrix  
          ccx decxcm add cm
          ccy decycm add cm translate
          angle rotate
          echelle cm dup scale
          zoomx zoomy scale
          hx 2 div neg
          hy 2 div neg translate} def
/cadre {
    currentlinewidth 2 div neg dup
    hx exch sub
    currentlinewidth 2 div neg dup
    hy exch sub rec} def
/showcadre {gsave initclip matrice1 kadre
             {.05 setlinewidth [] 0 setdash
            0. setgray cadre stroke}
              if
            grestore} def
/sg {moveto lineto stroke} def
/sge {moveto lineto gsave 1. setgray
      [] 0 setdash stroke grestore stroke} def
/d {currentgray mark} def
/f {setgray newpath moveto
      counttomark 2 idiv {lineto} repeat
    closepath fill cleartomark setgray} def
/inc {matrice1 initclip 0 hx 0 hy rec
      clip newpath matrice} def
/hdc {inc rec clip newpath} def
/aller {3 copy 3 1 roll moveto currentlinewidth
        exch dup .1 mul setlinewidth} def
/seg0 {aller dup neg 0 exch 0 rmoveto rlineto
       stroke setlinewidth} def
/seg1 {aller .70711 mul dup dup neg dup rmoveto
       rlineto stroke setlinewidth} def
/seg2 {aller dup neg 0 exch 0 4 1 roll rmoveto
       rlineto stroke setlinewidth} def
/seg3 {aller .70711 mul neg dup neg dup dup neg
       rmoveto rlineto stroke setlinewidth} def
/cplus {seg0 neg seg0 seg2 neg seg2
       pop pop pop} def
/cx {seg1 neg seg1 seg3 neg seg3
       pop pop pop} def
/cstar {3 copy cplus cx} def
/rond  {currentlinewidth 4 1 roll dup .1 mul
       setlinewidth 0 360 arc stroke
       setlinewidth} def
/rond2 {0 360 arc stroke} def
/rondf {0 360 arc fill} def
% x y alpha string
/ecr {dup 5 1 roll stringwidth
      2 index neg mul 3 index add exch
      2 index neg mul 4 index add exch
      moveto pop pop pop show newpath} def
/cartouche{/dessin dessin 1 add def
           latex not
          {gsave initgraphics
           1 cm 1 cm scale
        grestore}
        if} def
/typetrait [[]
            [0.03 .07]
            [0.1]
            [0.05 0.07 .2 0.07]
            [0.15 0.07]
            [0.03 0.03 .03 .08]
            [0.03 0.05 .03 .05 .15 .05]
            [0.25 .07]] def
/dt {dup 0 lt
     {pop}
     {8 mod typetrait exch get 0 setdash}
     ifelse
     dup 0 lt {pop}
     {.1 mul setlinewidth}
     ifelse} def
/initf3d {gsave /initCPU usertime def
    /dessin 1 def /matini matrix currentmatrix def
    latex
    {/echelle
      hhx hx angle cos mul abs
          hy angle sin mul abs add div
      hhy hx angle sin mul abs
          hy angle cos mul abs add div
      2 copy
      gt {exch} if pop
      def
      /xmin 0. def
      /xmax hx def
      /ymin 0. def
      /ymax hy def
      %-- position du cadre dans le rectangle
      currentpoint
      /ccy exch ptcm div def
      /ccx exch ptcm div def
    }
    {/echelle 1 def
     /xmin 0. def
     /xmax hx def
     /ymin 0. def
     /ymax hy def
     /ccx xpapier 2 div def
     /ccy ypapier 2 div def
% position du centre du rectangle
% sur la feuille en cm
    }
    ifelse
    /dessin 0 def
    matrice
    showcadre
    cartouche
    inc
    } def
 
%  fin des definition PostScript pour Fortran 3D %
