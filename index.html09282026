<style>
:root{
  --ink:#10141f;         /* deep-space navy-black, from the V1/V2 covers */
  --paper:#fbfaf7;       /* warm page white */
  --navy:#1b2a4a;        /* V1 cover field */
  --gold:#c8a24a;        /* V3 cover gold */
  --gold-soft:#e6d9b8;
  --crimson:#9d2b2b;     /* ACM spine red, used sparingly */
  --slate:#5b6473;
  --hairline:#e2ddd2;
  --maxw:72rem;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);
  font:16px/1.6 "Iowan Old Style","Palatino Linotype","Book Antiqua",Palatino,Georgia,serif}
h1,h2,h3{font-family:"Palatino Linotype","Book Antiqua",Palatino,Georgia,serif;line-height:1.2;margin:0 0 .4em}
h2{font-size:1.55rem;letter-spacing:.01em}
h3{font-size:1.08rem}
a,a:link,a:visited{color:var(--navy);text-decoration:none;border-bottom:1px solid var(--gold-soft)}
a:hover{color:var(--crimson);border-bottom-color:var(--crimson)}
a:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 1.25rem}
section{padding:2.6rem 0;border-top:1px solid var(--hairline)}
.eyebrow{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-size:.72rem;
  letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-bottom:.6rem}
/* top banner: all links white, every state, no exceptions */
nav.top a, nav.top a:link, nav.top a:visited, nav.top a:hover, nav.top a:active,
header.hero a, header.hero a:link, header.hero a:visited, header.hero a:hover, header.hero a:active{
  color:#fff !important; border-bottom-color:rgba(255,255,255,.45) !important;}
/* top nav */
nav.top{position:sticky;top:0;z-index:50;background:var(--ink);color:#efe9db}
nav.top .wrap{display:flex;flex-wrap:wrap;gap:.2rem 1.1rem;align-items:center;padding:.55rem 1.25rem}
nav.top .name{font-weight:700;letter-spacing:.02em;margin-right:auto;color:#fff;border:0}
nav.top a,nav.top a:link,nav.top a:visited{color:#e8ddbe;border:0;font-size:.88rem}
nav.top a:hover{color:var(--gold)}
/* hero */
header.hero{background:var(--ink);color:#efe9db;padding:2.4rem 0 0}
.hero .wrap{display:flex;gap:2rem;align-items:flex-start;flex-wrap:wrap}
.hero img.portrait{width:168px;border-radius:6px;border:1px solid #33405f}
.hero h1{color:#fff;font-size:2rem}
.hero .zh{font-weight:400;color:var(--gold)}
.hero .roles{margin:.6rem 0 0;color:#cfd6e4;font-size:.95rem}
.hero .roles b{color:#fff;font-weight:600}
.hero .links{margin:.9rem 0 0;display:flex;flex-wrap:wrap;gap:.45rem}
.hero .links a,.hero .links a:link,.hero .links a:visited{background:#1e2a44;border:1px solid #33405f;color:#e8ddbe;
  padding:.18rem .6rem;border-radius:999px;font-size:.8rem}
.hero .links a:hover{border-color:var(--gold);color:var(--gold)}
.tagline{color:var(--gold-soft);font-style:italic;margin:.5rem 0 0}
/* constellation spine (signature) */
.spine{background:var(--ink);padding:.6rem 0 1.6rem}
.spine svg{display:block;width:100%;height:auto}
.spine a,.spine a:link,.spine a:visited{border:0}
.spine a:visited text{fill:#f2e2ad}
.spine text{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;fill:#cdb46a;font-size:11px}
.spine .vol text{fill:#f2e2ad;font-weight:700}
.spine circle{fill:#7d8db0}
.spine .vol circle{fill:var(--gold)}
.spine line{stroke:#3a4a6e;stroke-width:1}
.spine .vol:hover circle{fill:#fff}
/* announcement strip */
.announce{background:#f4efe2;border-top:2px solid var(--gold);border-bottom:1px solid var(--hairline)}
.announce .wrap{padding:.85rem 1.25rem;font-size:.95rem}
.announce b{color:var(--crimson)}
.announce a{white-space:nowrap}
/* cards & grids */
.grid{display:grid;gap:1.1rem}
.g3{grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}
.g2{grid-template-columns:repeat(auto-fit,minmax(19rem,1fr))}
.card{background:#fff;border:1px solid var(--hairline);border-radius:8px;padding:1rem 1.1rem}
.card h3 a{border:0}
.card p{margin:.35rem 0 0;font-size:.93rem;color:#333}
/* trilogy */
.trilogy .card{text-align:center}
.trilogy img{width:100%;max-width:220px;border:1px solid var(--hairline);border-radius:4px}
.trilogy .thesis{font-style:italic;color:var(--slate)}
/* chips */
.chip{display:inline-block;font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  font-size:.7rem;letter-spacing:.03em;padding:.1rem .45rem;border-radius:4px;
  border:1px solid var(--hairline);background:#f2eee3;color:var(--navy);margin-right:.35rem}
.chip.venue{background:var(--navy);color:#f2e2ad;border-color:var(--navy)}
.chip.hot{background:var(--crimson);color:#fff;border-color:var(--crimson)}
.chip.gold{background:var(--gold);color:var(--ink);border-color:var(--gold)}
/* publications */
.pub{padding:.85rem 0;border-bottom:1px dashed var(--hairline)}
.pub .t{font-weight:600}
.pub .a{font-size:.9rem;color:var(--slate)}
.pub .tl{font-size:.9rem;margin:.25rem 0 0}
.pub .l{font-size:.85rem}
/* timeline */
.timeline{display:flex;gap:1rem;overflow-x:auto;padding:.4rem 0 1rem}
.timeline .card{min-width:15.5rem}
.timeline .yr{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;color:var(--gold);font-weight:700}
/* books grid */
.books .card img{width:100%;border:1px solid var(--hairline);border-radius:4px}
.books .card{text-align:center}
.books .meta{font-size:.85rem;color:var(--slate)}
/* teaching & background */
ul.clean{list-style:none;padding:0;margin:0}
ul.clean li{padding:.4rem 0;border-bottom:1px dashed var(--hairline)}
footer{background:var(--ink);color:#aeb6c6;padding:1.4rem 0;margin-top:2.5rem;font-size:.9rem}
footer a,footer a:link,footer a:visited{color:var(--gold);border:0}
@media (max-width:640px){ .hero img.portrait{width:128px} h2{font-size:1.35rem} }
@media (prefers-reduced-motion:reduce){ html{scroll-behavior:auto} }
</style>
