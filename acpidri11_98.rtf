The block of sample code below shows one way to do step 1. It is a routine that sends an }{\b IRP_MN_QUERY_INTERFACE}{ request to the ACPI driver to get the currently-loaded ACPI driver\rquote s direct interfaces.
\par }\pard\plain \s53\li360\keep\keepn\widctlpar\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6840\adjustright \f2\fs16\cgrid {NTSTATUS
\par GetAcpiInterfaces(
\par     IN PDEVICE_OBJECT   Pdo
\par     )
\par /*
\par Routine Description:
\par     Call ACPI driver to get the direct-call interfaces.  It does
\par     this the first time it is called, no more.
\par Arguments:
\par     None.
\par Return Value:
\par     Status
\par */
\par \{
\par     NTSTATUS                Status = STATUS_SUCCESS;
\par     PIRP                    Irp;
\par     PIO_STACK_LOCATION      IrpSp;
\par \tab // Only need to do this once
\par \tab if (!LowerPdo) \{ }{\b\i Note: This references the top driver in the stack. Once the interface table is in place, this reference can be dropped.]}{
\par         LowerPdo = IoGetAttachedDeviceReference (Pdo);
\par \tab \tab // Allocate an IRP for below
\par \tab \tab Irp = IoAllocateIrp (LowerPdo->StackSize, FALSE);\tab // Get stack size from PDO
\par \tab \tab \tab .
\par \tab \tab \tab .
\par \tab \tab \tab .
\par \tab \tab IrpSp = IoGetNextIrpStackLocation(Irp);
\par         //
\par         // Use QUERY_INTERFACE to get the address of the direct-call ACPI interfaces.
\par         //
\par         IrpSp->MajorFunction = IRP_MJ_PNP;
\par         IrpSp->MinorFunction = IRP_MN_QUERY_INTERFACE;
\par         IrpSp->Parameters.QueryInterface.InterfaceType=(LPGUID)
\par \tab \tab \tab \tab \tab \tab \tab \tab \tab \tab \tab \tab \tab \tab &GUID_ACPI_INTERFACE_STANDARD;
\par         IrpSp->Parameters.QueryInterface.Version = 1;
\par         IrpSp->Parameters.QueryInterface.Size = sizeof (AcpiInterfaces);
\par         IrpSp->Parameters.QueryInterface.Interface = (PINTERFACE) &AcpiInterfaces;
\par         IrpSp->Parameters.QueryInterface.InterfaceSpecificData  = NULL;
\par         IoSetCompletionRoutine(Irp,MyDriverSynchronousRequest,NULL,FALSE, FALSE);
\par         Status = IoCallDriver (LowerPdo, Irp);
\par         IoFreeIrp (Irp);
\par \tab \}
\par     return Status;
\par \}
\par 
\par }\pard\plain \s15\sa160\sl-240\slmult0\widctlpar\adjustright \fs21\cgrid {The block of code below shows step 2 of the process of registering for device notifications. It uses a direct call to the }{\b RegisterForDeviceNotification}{
